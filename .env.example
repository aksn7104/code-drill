# 通知（notify.py）の秘密の設定の見本です。
# このファイルを .env という名前でコピーして、必要な項目だけ値を書いて使います。
#   ・.env は、このPCの中だけに置きます。Git には上がりません（.gitignore で除外しています）。
#   ・この .env.example には、本物の値を書かないでください（Git に上がります）。
# 書き方は「名前=値」です。使わない項目は、空のままで構いません。

# ----- メールを使うとき（config.yaml の notifier: email と privacy: standard）-----
DRILL_SMTP_HOST=
DRILL_SMTP_PORT=
# starttls（既定）/ ssl / none（暗号化なし。自分のPCの中だけで使う）
DRILL_SMTP_SECURITY=
# ログインが要るサーバーのときだけ。ユーザー名とパスワードの両方が必要です
DRILL_SMTP_USER=
DRILL_SMTP_PASSWORD=
DRILL_MAIL_FROM=
# 複数はカンマで区切ります
DRILL_MAIL_TO=

# ----- スマホに通知するとき（config.yaml の notifier: ntfy と privacy: standard）-----
# 送り先の名前。10文字以上の英数字・- ・_ で、推測されにくいもの（知っている人は誰でも読めます）
DRILL_NTFY_TOPIC=
# 自分で立てたサーバーを使うときだけ。空なら https://ntfy.sh
DRILL_NTFY_SERVER=
# アクセス制限のあるサーバーのときだけ
DRILL_NTFY_TOKEN=

